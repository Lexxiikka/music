  {
    "title": "Разговор",
    "artist": "Павел Пламенев",
    "audio": "sounds/music__Павел_Пламенев__Разговор.mp3",
    "bg": "sounds/background__Павел_Пламенев__Разговор.mp4",
    "icon": "sounds/icon__Павел_Пламенев__Разговор.png",
    "round_icon": 30,
    "sound_multiplier": 0.8,
    "subtitles": {
      "32.92": { "text": "Я пришел поведать в дальних краях", "glow": "#750003" },
      "36.03": { "text": "О том, что мир погибает в боях", "glow": "#750003" },
      "39.72": { "text": "О том, что он верит ложным словам", "glow": "#750003" },
      "42.85": { "text": "О том, что ты нужен нам", "glow": "#750003" },
      "47.39": { "text": "Почему жестока наша земля?", "glow": "#750003" },
      "50.50": { "text": "Я видел все, пока дошел до тебя", "glow": "#750003" },
      "54.20": { "text": "И на пути я встретил лишь боль", "glow": "#750003" },
      "57.32": { "text": "Дай ответ, почему мир такой", "glow": "#750003" },
      "61.28": { "text": "Я создал его сам из крови своей", "glow": "#00a8b7" },
      "67.54": { "text": "Я сшивал из света звезд глади морей", "glow": "#00a8b7" },
      "73.20": { "text": "Не затем, чтоб ты спросил: «Зачем он жесток?»", "glow": "#00a8b7" },
      "79.17": { "text": "Ведь это вы себя сгубили,", "glow": "#00a8b7" },
      "82.88": { "text": "а я Создатель, Бог", "glow": "#00a8b7" },
      "88.81": { "text": "Где твой свет? вокруг одна только тьма//", "glow": "#750003" },
      "92.50": { "text": "Я вижу зло, мне не подвластна судьба", "glow": "#750003" },
      "95.90": { "text": "В смертных умах господствует страх", "glow": "#750003" },
      "99.03": { "text": "Дай мне силу, и сгинет твой враг!", "glow": "#750003" },
      "105.00": { "text": "Я создал его сам из крови своей", "glow": "#00a8b7" },
      "110.67": { "text": "Я сшивал из света звезд глади морей", "glow": "#00a8b7" },
      "116.62": { "text": "Не затем, чтоб ты спросил: «А зачем он жесток?»", "glow": "#00a8b7" },
      "122.87": { "text": "Я не Спаситель, не Хранитель, я Создатель. Бог", "glow": "#00a8b7" },
      "141.61": { "text": "Дам силу и огонь вспыхнет в душе", "glow": "#00a8b7" },
      "147.84": { "text": "Путь невозможный твой начат уже", "glow": "#00a8b7" },
      "154.37": { "text": "Луч солнечный сожми — он твой клинок", "glow": "#00a8b7" },
      "159.52": { "text": "Не будет зла отныне в мире — так сказал твой Бог", "glow": "#00a8b7" },
      "168.61": { "text": "Однажды люди сгинут", "glow": "#e9ae72" },
      "172.21": { "text": "В слепом огне вражды", "glow": "#e9ae72" },
      "175.34": { "text": "Их души мир покинут", "glow": "#e9ae72" },
      "178.86": { "text": "Который создал ты", "glow": "#e9ae72" },
      "182.25": { "text": "Останутся лишь Боги", "glow": "#e9ae72" },
      "185.94": { "text": "Одни, среди руин", "glow": "#e9ae72" },
      "189.36": { "text": "Разбитые дороги", "glow": "#e9ae72" },
      "192.77": { "text": "И ты их господин", "glow": "#e9ae72" }
    }
  },
  {
    "title": "Хомо Саспенс",
    "artist": "DEEP-EX-SENSE",
    "audio": "sounds/music__DEEP-EX-SENSE__Хомо_Саспенс.mp3",
    "bg": "sounds/background__DEEP-EX-SENSE__Хомо_Саспенс.mp4",
    "icon": "sounds/icon__DEEP-EX-SENSE__Хомо_Саспенс.png",
    "round_icon": 30,
    "sound_multiplier": 0.7,
    "subtitles": {
      "8.72": { "text": "Мы убиваем ради забавы", "glow": "#B22222" },
      "10.06": { "text": "И превратим любого друга во врага из-за нала", "glow": "#A52A2A" },
      "12.40": { "text": "Те, кто меняли мир, давно потеряли запалы", "glow": "#FF8C00" },
      "14.40": { "text": "Глупые мечты, кто бы реализовал их", "glow": "#808080" },
      "16.40": { "text": "Только не ради регалий и славы", "glow": "#DAA520" },
      "18.09": { "text": "А дело за малым, но нас будто парализовало", "glow": "#4682B4" },
      "20.65": { "text": "Уступать легко и реалистов валом", "glow": "#5F9EA0" },
      "22.07": { "text": "Только компромиссов мало, плодят армии солдат", "glow": "#2E8B57" },
      "24.34": { "text": "И собирается толпа — сегодня ядерный солд-аут", "glow": "#FF4500" },
      "26.90": { "text": "Мы верим только в суть, но суть фиктивна", "glow": "#A9A9A9" },
      "28.88": { "text": "И все, что нами движет, лишь субъективно", "glow": "#87CEEB" },
      "31.16": { "text": "Идеологии окутывают судьбы тиной", "glow": "#6B8E23" },
      "33.43": { "text": "Никогда системе ценностей не быть единой", "glow": "#9370DB" },
      "35.69": { "text": "Человек разумен — это факт, пацан", "glow": "#1E90FF" },
      "37.97": { "text": "Человек разумен — ведь он так сказал", "glow": "#1E90FF" },
      "40.25": { "text": "Человек безумен, и он впал в азарт", "glow": "#8A2BE2" },
      "42.51": { "text": "Налей-ка мне вина, старина Валтасар, ~ей", "glow": "#A0522D" },
      "44.79": { "text": "Только разума нам явно не хватит", "glow": "#696969" },
      "47.35": { "text": "Чтобы понял каждый ярый фанатик", "glow": "#FFA500" },
      "49.33": { "text": "Что без разницы какой ты расы", "glow": "#F5DEB3" },
      "51.32": { "text": "Когда над тобой миллиарды галактик", "glow": "#4169E1" },
      "54.18": { "text": "И никак не понять человеку", "glow": "#778899" },
      "55.90": { "text": "Что организм лишь миллиарды молекул", "glow": "#00BFFF" },
      "58.15": { "text": "Ведь каждый быть хочет подобием Бога", "glow": "#FFD700" },
      "60.43": { "text": "Оттого и кажется им Дарвин нелепым", "glow": "#228B22" },
      "62.99": { "text": "Назвав иных зверьми — оскорбил бы зверей я", "glow": "#8B4513" },
      "65.27": { "text": "А мы жаждем бороздить измерения", "glow": "#9400D3" },
      "66.99": { "text": "Технических прогресс, но ведем себя так", "glow": "#A9A9A9" },
      "69.25": { "text": "Будто еще вчера мы спустились с деревьев", "glow": "#32CD32" },
      "71.53": { "text": "Ты из гоминид — ты доминируй", "glow": "#FF8C00" },
      "73.00": { "text": "Истребляй виды, не подавая виду", "glow": "#B22222" },
      "74.93": { "text": "Смотри, какой огромный мир", "glow": "#87CEFA" },
      "76.32": { "text": "Он ждет погромов и войны", "glow": "#DC143C" },
      "77.20": { "text": "И сколько же нас тут?", "glow": "#C0C0C0" },
      "78.30": { "text": "Наши потребности растут", "glow": "#3CB371" },
      "79.72": { "text": "Мы здесь постоим свою пирамиду", "glow": "#DAA520" },
      "81.71": { "text": "В осколках сброшенных кем-то бомб", "glow": "#FF7F50" },
      "85.23": { "text": "Призракам прошлого вечный дом", "glow": "#708090" },
      "90.73": { "text": "Горький опыт как педагог", "glow": "#A0522D" },
      "95.08": { "text": "Но эти дети не любят школу", "glow": "#A9A9A9" },
      "99.65": { "text": "Владея мощностью мегатонн", "glow": "#E30B0B" },
      "103.91": { "text": "Чтоб уничтожить весь генофонд", "glow": "#8B0000" },
      "108.46": { "text": "Страшней чудовищ и всех богов", "glow": "#8B008B" },
      "112.74": { "text": "Наша любовь к жестоким шоу", "glow": "#FF4500" },
      "116.44": { "text": "Истреблять себе подобных человек мог", "glow": "#B22222" },
      "118.43": { "text": "Человек — Бог!", "glow": "#FFD700" },
      "119.57": { "text": "Они молили о пощаде, но человек глох", "glow": "#696969" },
      "121.83": { "text": "Против силы нет слов", "glow": "#A9A9A9" },
      "122.97": { "text": "Кто такой человек?", "glow": "#4682B4" },
      "124.19": { "text": "Несомненно, человек — зло", "glow": "#DC143C" },
      "125.61": { "text": "От злых духов не поможет твой ловец снов", "glow": "#9370DB" },
      "127.88": { "text": "Ведь они живут внутри сердец тех, кто", "glow": "#FF69B4" },
      "129.89": { "text": "Потонул в невежестве и все мы беженцы", "glow": "#808080" },
      "131.87": { "text": "Ведь от реальности бежим прочь со всех ног", "glow": "#87CEEB" },
      "134.73": { "text": "Пережив волну", "glow": "#1E90FF" },
      "135.31": { "text": "Моряки ликуют лишь до следующей волны", "glow": "#00CED1" },
      "137.30": { "text": "Фермер, покажи нам, где наши плоды", "glow": "#228B22" },
      "139.01": { "text": "Если посадить косточку в землю, то вырастет дерево", "glow": "#8B4513" },
      "141.56": { "text": "А там уже этих костей накопилось немерено", "glow": "#696969" },
      "143.83": { "text": "Мир стоит на костях", "glow": "#708090" },
      "145.83": { "text": "Но мы видим чужие смерти лишь в новостях", "glow": "#A9A9A9" },
      "147.55": { "text": "Пока рядом нет танков, мы «в танке», мы — ангелы", "glow": "#ADD8E6" },
      "150.09": { "text": "Только кости под ногами так хрустят", "glow": "#F5DEB3" },
      "152.37": { "text": "У каждого правда своя, свой бог, свой менталитет", "glow": "#9370DB" },
      "154.65": { "text": "Каждый найдет причину сбросить бомбу на твоих детей", "glow": "#B22222" },
      "157.78": { "text": "Тот, кто придумал эту фразу, не прав был", "glow": "#808080" },
      "159.95": { "text": "«Правда у каждого своя» — выходит, нет правды", "glow": "#696969" },
      "161.71": { "text": "Не пожалеем мела, начертим большой квадрат", "glow": "#F0F0F0" },
      "164.20": { "text": "Размером со страну, а может даже больше", "glow": "#FFA500" },
      "166.83": { "text": "И тех, кто в него не войдет, мы будем карать", "glow": "#DC143C" },
      "168.25": { "text": "Всех, кто из него выйдет, мы покараем тоже", "glow": "#B22222" },
      "171.20": { "text": "Всюду нам мерещатся капканы, враги", "glow": "#708090" },
      "173.30": { "text": "Ради иллюзий мы готовы стать врагами другим", "glow": "#FF8C00" },
      "175.80": { "text": "Предрассудки не броня — не пробить", "glow": "#A9A9A9" },
      "177.50": { "text": "Хоть когтями их рви — еретикам не протянем руки", "glow": "#B22222" },
      "180.20": { "text": "Он одевается не так как мы, верит не в то, во что мы", "glow": "#C0C0C0" },
      "182.50": { "text": "Смотри, он не такой совсем, каким он должен быть", "glow": "#87CEEB" },
      "184.20": { "text": "Какой нам смысл оставлять теперь его в живых?", "glow": "#8B0000" },
      "187.40": { "text": "Серия ножевых и это тоже выход", "glow": "#DC143C" },
      "190.00": { "text": "В осколках сброшенных кем-то бомб", "glow": "#FF7F50" },
      "193.50": { "text": "Призракам прошлого вечный дом", "glow": "#708090" },
      "198.50": { "text": "Горький опыт как педагог", "glow": "#A0522D" },
      "202.65": { "text": "Но эти дети не любят школу", "glow": "#A9A9A9" },
      "207.25": { "text": "Владея мощностью мегатонн", "glow": "#E30B0B" },
      "211.75": { "text": "Чтоб уничтожить весь генофонд", "glow": "#8B0000" },
      "216.22": { "text": "Страшней чудовищ и всех богов", "glow": "#8B008B" },
      "220.25": { "text": "Наша любовь к жестоким шоу", "glow": "#FF4500" },
      "225.86": { "text": "Фильмы, книги", "glow": "#D3D3D3" },
      "229.84": { "text": "Мы привыкли", "glow": "#D3D3D3" },
      "234.11": { "text": "Нам грозят лишь", "glow": "#D3D3D3" },
      "238.37": { "text": "Злые силы", "glow": "#DC143C" },
      "243.21": { "text": "Зло приходит", "glow": "#B22222" },
      "247.46": { "text": "Мир спасают", "glow": "#1E90FF" },
      "251.99": { "text": "Но ведь есть другой сценарий", "glow": "#9370DB" },
      "261.10": { "text": "Где она смотрит в небо на звезды в ночи", "glow": "#4169E1" },
      "266.50": { "text": "Ей все надоело, есть сотни причин", "glow": "#A9A9A9" },
      "270.99": { "text": "Зашить её вены не смогут врачи", "glow": "#B22222" },
      "275.61": { "text": "И все её тело, как сломанный щит", "glow": "#808080" },
      "280.17": { "text": "Кровавая лава зальет города", "glow": "#FF4500" },
      "284.99": { "text": "И все наши планы сотрет навсегда", "glow": "#696969" },
      "288.99": { "text": "Она вскрыла вены, ушла на покой", "glow": "#8B0000" },
      "293.52": { "text": "Так наша планета покончит с собой", "glow": "#DC143C" }
    },
