        "69.8": { "text": "Но я в Стиксе утопну,", "glow": "#4169E1" },
        "71.2": { "text": "я стать обречен его дном", "glow": "#4169E1" },
        "72.9": { "text": "Из грехов уличенный в одном:", "glow": "#A9A9A9" },
        "74.8": { "text": "в этом мире скучать - моветон", "glow": "#A9A9A9" },
        "76.5": { "text": "И все мы одинаковы в погоне за высотами:", "glow": "#87CEEB" },
        "78.9": { "text": "\"Смотрите все, особая особа я\"", "glow": "#9370DB" },
        "80.8": { "text": "Тут нет друзей, если не ловит сотовый", "glow": "#808080" },
        "82.6": { "text": "Отчаяние приходит с опытом", "glow": "#696969" },
