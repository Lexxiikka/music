    "subtitles": {
      "1.0": { "text": "Фон не подходит, да, ну и что ты мне сделаешь?", "glow": "#81a99b" },
      "11.9": "Странная штука эта ваша дружба,",
      "14.8": "Разные люди находят коннект:",
      "17.8": "Скины и нефоры, панки и рэперы,",
      "20.8": "Много историй — значит, много друзей",
      "23.1": { "text": "Вот мои кенты своровали из Магнита", "glow": "red" },
      "26.3": { "text": "Портвейн, «Доширак» и пачку молока", "glow": "#8B4513" },
      "28.9": { "text": "Нажрались на площадке,", "glow": "#D2B48C" },
      "30.6": { "text": "пьяные свиньи,", "glow": "#F5F5DC" },
      "32.3": { "text": "и пошли блевать у городка", "glow": "gray" },
      "34.9": { "text": "На Новый год собрались мы на кухне,", "glow": "#008c1a" },
      "38.0": "и тут Илюха решил выдать тост",
      "40.3": { "text": "(Щас скажу)", "glow": "black" },
      "41.1": "Но, к сожалению,",
