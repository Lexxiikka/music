      "88.89": { "text": "Моя муза шальна, своевольна", "glow": "#E080A0" },
      "91.73": { "text": "Не дает ни покоя, ни сна", "glow": "#B39DDB" },
      "94.56": { "text": "Просто жить — это скучно и больно", "glow": "#9E9E9E" },
